<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.TradConnect" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/marron_bronce</item>
        <item name="colorPrimaryVariant">@color/olivegreen</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/olivegreen</item>
        <item name="colorSecondaryVariant">@color/olivegreen</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->


    </style>

    <!--SplashScreen Theme-->
    <style name="Theme.LoginApp.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">
            @color/terracota
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher_round
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.TradConnect
        </item>


    </style>
</resources>